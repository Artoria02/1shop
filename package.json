{
    "name":  "1shop",
    "version":  "0.1.0",
    "private":  true,
    "scripts":  {
                    "dev":  "next dev",
                    "build":  "next build",
                    "start":  "next start",
                    "lint":  "eslint . --config config/eslint.config.mjs",
                    "typecheck":  "tsc --noEmit",
                    "format":  "prettier --check .",
                    "format:write":  "prettier --write .",
                    "db:generate":  "prisma generate --config config/prisma.config.ts",
                    "db:migrate":  "prisma migrate dev --config config/prisma.config.ts",
                    "db:push":  "prisma db push --config config/prisma.config.ts",
                    "db:studio":  "prisma studio --config config/prisma.config.ts",
                    "db:seed":  "prisma db seed --config config/prisma.config.ts",
                    "infra:up":  "docker compose -f infra/docker-compose.yml up -d",
                    "infra:down":  "docker compose -f infra/docker-compose.yml down",
                    "test":  "vitest run --config config/vitest.config.ts"
                },
    "dependencies":  {
                         "@prisma/adapter-pg":  "^7.8.0",
                         "@prisma/client":  "7.8.0",
                         "bcryptjs":  "^3.0.2",
                         "ioredis":  "5.11.0",
                         "jose":  "^6.1.1",
                         "next":  "16.2.7",
                         "react":  "19.2.7",
                         "react-dom":  "19.2.7",
                         "zod":  "^4.4.3"
                     },
    "devDependencies":  {
                            "@types/node":  "24.10.1",
                            "@types/react":  "19.2.16",
                            "@types/react-dom":  "19.2.3",
                            "eslint":  "9.39.4",
                            "eslint-config-next":  "16.2.7",
                            "prettier":  "3.8.3",
                            "prisma":  "7.8.0",
                            "tsx":  "4.22.4",
                            "typescript":  "6.0.3",
                            "vitest":  "^4.1.8"
                        }
}